# Copy to .env and fill in. Never commit .env.
# Groq API key (free tier). Get one at https://console.groq.com/keys
GROQ_API_KEY=
# Groq model for reviews (free tier).
GROQ_MODEL=openai/gpt-oss-20b
# Onyx testnet RPC.
RPC_URL=https://rpc.latest.testnets.gno.land:443
# Chain ID of the testnet.
CHAIN_ID=onyx-1
# The deployed GnoSage board realm, e.g. gno.land/r/g1.../gnosage
GNOSAGE_REALM=
# gnokey key name holding the agent's throwaway testnet key.
AGENT_KEY_NAME=gnosage-agent
# Bech32 address of the agent key (needed only for the split-flow
# broadcast fallback used on sandboxed runners; see poster.ts).
AGENT_ADDRESS=
# Path to the txencode helper (amino JSON -> binary hex). Only needed
# for the split-flow fallback. Build it from the gno checkout:
# go build -o ~/go/bin/txencode ./tmp-txencode
TXENCODE_BIN=
# gnokey home (keybase location).
GNOKEY_HOME=
# Gas for the PostReview call.
GAS_FEE=5000ugnot
GAS_WANTED=5000000
# Keybase password for the agent key (gnokey -insecure-password-stdin).
GNOKEY_PASSWORD=
